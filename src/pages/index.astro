import { getCollection } from 'astro:content';

// 1. Ambil seluruh koleksi berita secara aman
const allBerita = (await getCollection('berita')) || [];

// 2. Urutkan berita berdasarkan tanggal terbaru (terbaru di paling awal)
const sortedBerita = [...allBerita].sort((a, b) => {
  const timeA = a.data?.pubDate ? new Date(a.data.pubDate).getTime() : 0;
  const timeB = b.data?.pubDate ? new Date(b.data.pubDate).getTime() : 0;

  const validA = Number.isNaN(timeA) ? 0 : timeA;
  const validB = Number.isNaN(timeB) ? 0 : timeB;

  return validB - validA; // Tanggal terbaru muncul lebih dahulu
});

// 3. Pembagian data berita secara berurutan untuk komponen halaman utama
const carouselBerita = sortedBerita.slice(0, 5); // 5 berita terbaru untuk "Berita Utama"
const mainBerita = sortedBerita.slice(0, 3);     // 3 berita terbaru untuk grid utama "BERITA & PENGUMUMAN TERBARU"
const extraBerita = sortedBerita.slice(3);        // Sisa berita terbaru untuk "Lihat Semua Berita"

const getCategoryBadge = (category: string) => {
  switch (category?.toUpperCase()) {
    case 'PRESTASI': return 'bg-blue-600 text-white';
    case 'FASILITAS': return 'bg-emerald-600 text-white';
    case 'PPDB': return 'bg-amber-500 text-slate-900';
    case 'KEGIATAN': return 'bg-purple-600 text-white';
    case 'EKSTRAKURIKULER': return 'bg-red-600 text-white';
    default: return 'bg-indigo-600 text-white';
  }
};
