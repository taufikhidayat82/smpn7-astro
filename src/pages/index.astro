    <!-- SCRIPT LOGIKA INTERAKTIF -->
    <script>
        const loader = document.getElementById('page-loader');

        function hideLoader() {
            if (!loader) return;
            loader.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                loader.classList.add('hidden');
            }, 300);
        }

        function showLoader() {
            if (!loader) return;
            loader.classList.remove('hidden', 'pointer-events-none');
            void loader.offsetWidth;
            loader.classList.remove('opacity-0');
        }

        window.addEventListener('load', () => {
            setTimeout(hideLoader, 300);
        });

        document.addEventListener('click', (e) => {
            const anchor = e.target.closest('a');
            if (!anchor) return;

            const href = anchor.getAttribute('href');
            const target = anchor.getAttribute('target');

            if (
                !href ||
                href.startsWith('#') ||
                href.startsWith('javascript:') ||
                target === '_blank' ||
                href.startsWith('mailto:') ||
                href.startsWith('tel:') ||
                (href.startsWith('http') && !href.includes(window.location.hostname))
            ) {
                return;
            }

            showLoader();
        });

        window.addEventListener('pageshow', (event) => {
            if (event.persisted) {
                hideLoader();
            }
        });

        // LOGIKA TOGGLE BERITA
        const toggleBeritaBtn = document.getElementById('toggleBeritaBtn');
        const extraBeritaContainer = document.getElementById('extraBeritaContainer');
        const btnText = document.getElementById('btnText');
        const btnIcon = document.getElementById('btnIcon');

        if (toggleBeritaBtn && extraBeritaContainer) {
            toggleBeritaBtn.addEventListener('click', () => {
                const isHidden = extraBeritaContainer.classList.contains('hidden');
                
                if (isHidden) {
                    extraBeritaContainer.classList.remove('hidden');
                    if(btnText) btnText.textContent = 'SEMBUNYIKAN BERITA';
                    if(btnIcon) btnIcon.classList.add('rotate-180');
                } else {
                    extraBeritaContainer.classList.add('hidden');
                    if(btnText) btnText.textContent = 'LIHAT SEMUA BERITA';
                    if(btnIcon) btnIcon.classList.remove('rotate-180');
                }
            });
        }

        // LOGIKA SLIDER HERO
        let currentSlideIndex = 0;
        const slides = document.querySelectorAll('.hero-slide');
        const dots = document.querySelectorAll('#slideDots button');
        const counterElement = document.getElementById('slideCounter');

        function updateSlider() {
            if (!slides.length) return;
            
            slides.forEach((slide, index) => {
                if (index === currentSlideIndex) {
                    slide.classList.remove('hidden', 'opacity-0', 'scale-95', 'absolute', 'inset-0');
                    slide.classList.add('block', 'opacity-100', 'scale-100');
                } else {
                    slide.classList.remove('block', 'opacity-100', 'scale-100');
                    slide.classList.add('hidden', 'opacity-0', 'scale-95', 'absolute', 'inset-0');
                }
            });

            dots.forEach((dot, index) => {
                if (index === currentSlideIndex) {
                    dot.className = "w-8 h-2 rounded-full bg-amber-400 transition-all duration-300";
                } else {
                    dot.className = "w-2.5 h-2 rounded-full bg-slate-700 hover:bg-slate-500 transition-all duration-300";
                }
            });

            if (counterElement) {
                counterElement.textContent = `0${currentSlideIndex + 1}`;
            }
        }

        dots.forEach((dot, idx) => {
            dot.addEventListener('click', () => {
                currentSlideIndex = idx;
                updateSlider();
            });
        });

        document.getElementById('nextSlide')?.addEventListener('click', () => {
            if (slides.length > 0) {
                currentSlideIndex = (currentSlideIndex + 1) % slides.length;
                updateSlider();
            }
        });

        document.getElementById('prevSlide')?.addEventListener('click', () => {
            if (slides.length > 0) {
                currentSlideIndex = (currentSlideIndex - 1 + slides.length) % slides.length;
                updateSlider();
            }
        });

        if (slides.length > 1) {
            setInterval(() => {
                currentSlideIndex = (currentSlideIndex + 1) % slides.length;
                updateSlider();
            }, 6000);
        }
    </script>
