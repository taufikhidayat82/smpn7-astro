    <script>
        // LOGIKA LOADING (Tetap dipertahankan)
        const loader = document.getElementById('page-loader');
        function hideLoader() {
            if (!loader) return;
            loader.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => { loader.classList.add('hidden'); }, 300);
        }
        window.addEventListener('load', () => { setTimeout(hideLoader, 300); });

        // LOGIKA SLIDER HERO (Tetap dipertahankan)
        let currentSlideIndex = 0;
        const slides = document.querySelectorAll('.hero-slide');
        const dots = document.querySelectorAll('#slideDots button');
        const counterElement = document.getElementById('slideCounter');

        function updateSlider() {
            if (!slides.length) return;
            slides.forEach((slide, index) => {
                if (index === currentSlideIndex) {
                    slide.classList.remove('hidden', 'opacity-0', 'scale-95', 'absolute', 'inset-0');
                    slide.classList.add('block', 'opacity-100', 'scale-100');
                } else {
                    slide.classList.remove('block', 'opacity-100', 'scale-100');
                    slide.classList.add('hidden', 'opacity-0', 'scale-95', 'absolute', 'inset-0');
                }
            });
            dots.forEach((dot, index) => {
                dot.className = index === currentSlideIndex 
                    ? "w-8 h-2 rounded-full bg-amber-400 transition-all duration-300"
                    : "w-2.5 h-2 rounded-full bg-slate-700 hover:bg-slate-500 transition-all duration-300";
            });
            if (counterElement) counterElement.textContent = `0${currentSlideIndex + 1}`;
        }
        dots.forEach((dot, idx) => {
            dot.addEventListener('click', () => { currentSlideIndex = idx; updateSlider(); });
        });
        document.getElementById('nextSlide')?.addEventListener('click', () => {
            if (slides.length > 0) { currentSlideIndex = (currentSlideIndex + 1) % slides.length; updateSlider(); }
        });
        document.getElementById('prevSlide')?.addEventListener('click', () => {
            if (slides.length > 0) { currentSlideIndex = (currentSlideIndex - 1 + slides.length) % slides.length; updateSlider(); }
        });
        if (slides.length > 1) {
            setInterval(() => { currentSlideIndex = (currentSlideIndex + 1) % slides.length; updateSlider(); }, 6000);
        }

        // TOGGLE BERITA
        const toggleBeritaBtn = document.getElementById('toggleBeritaBtn');
        const extraBeritaContainer = document.getElementById('extraBeritaContainer');
        const btnText = document.getElementById('btnText');
        if (toggleBeritaBtn && extraBeritaContainer) {
            toggleBeritaBtn.addEventListener('click', () => {
                const isHidden = extraBeritaContainer.classList.contains('hidden');
                if (isHidden) {
                    extraBeritaContainer.classList.remove('hidden');
                    if(btnText) btnText.textContent = 'SEMBUNYIKAN BERITA';
                    // Trigger observer lagi untuk berita tambahan yang baru muncul
                    setTimeout(() => {
                        const newReveals = extraBeritaContainer.querySelectorAll('.reveal-up');
                        newReveals.forEach(el => revealObserver.observe(el));
                    }, 50);
                } else {
                    extraBeritaContainer.classList.add('hidden');
                    if(btnText) btnText.textContent = 'LIHAT SEMUA BERITA';
                    // Reset kelas active agar bisa beranimasi lagi jika dibuka
                    const hideReveals = extraBeritaContainer.querySelectorAll('.reveal-up');
                    hideReveals.forEach(el => el.classList.remove('active'));
                }
            });
        }

        // ==========================================
        // LOGIKA BARU: ANIMASI WIPE UP (INTERSECTION OBSERVER)
        // ==========================================
        const revealElements = document.querySelectorAll('.reveal-up');
        
        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    // Tambahkan kelas active saat elemen terlihat di layar
                    entry.target.classList.add('active');
                    // Berhenti memantau elemen ini agar animasi tidak berulang terus
                    observer.unobserve(entry.target); 
                }
            });
        }, {
            root: null,
            threshold: 0.1, // Berjalan saat 10% dari elemen sudah muncul
            rootMargin: "0px 0px -40px 0px" // Sedikit menunda trigger sebelum elemen benar-benar masuk layar
        });

        // Terapkan observer ke seluruh elemen yang memiliki class .reveal-up
        revealElements.forEach(el => revealObserver.observe(el));
    </script>
</body>
</html>