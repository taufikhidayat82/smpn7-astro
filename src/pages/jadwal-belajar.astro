const getSubjectBadge = (subject: string) => {
  if (subject.includes('ISTIRAHAT')) return 'bg-rose-100 text-rose-700 font-bold border border-rose-200';
  if (subject.includes('UPACARA') || subject.includes('KOKURIKULER')) return 'bg-amber-100 text-amber-800 font-bold border border-amber-300';
  if (subject.includes('MTK')) return 'bg-blue-100 text-blue-800 font-semibold';
  if (subject.includes('IPA')) return 'bg-emerald-100 text-emerald-800 font-semibold';
  if (subject.includes('B.INDO') || subject.includes('B.ING')) return 'bg-indigo-100 text-indigo-800 font-semibold';
  if (subject.includes('PJOK')) return 'bg-orange-100 text-orange-800 font-semibold';
  if (subject.includes('AGAMA')) return 'bg-purple-100 text-purple-800 font-semibold';
  if (subject.includes('INFORMATIKA')) return 'bg-cyan-100 text-cyan-800 font-semibold';
  return 'bg-slate-100 text-slate-800 font-medium';
};
