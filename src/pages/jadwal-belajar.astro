      { jam: '08:40 - 09:15', vii: 'IPS', viiiA: 'PJOK', viiiB: 'PKN', ix: 'IPA' },
      { jam: '09:15 - 09:30', vii: 'ISTIRAHAT', viiiA: 'ISTIRAHAT', viiiB: 'ISTIRAHAT', ix: 'ISTIRAHAT' },
      { jam: '09:30 - 10:05', vii: 'KKA', viiiA: 'PKN', viiiB: 'IPA', ix: 'MTK' },
