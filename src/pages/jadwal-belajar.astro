    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }

        /* Styling Navigasi Royal Classic */
        .nav-royal-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 1rem 0.85rem;
            font-weight: 600;
            color: #cbd5e1;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            font-size: 0.875rem;
        }

        .nav-royal-btn::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            width: 0%;
            height: 3px;
            background-color: #fbbf24;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            transform: translateX(-50%);
            border-radius: 2px 2px 0 0;
        }

        .nav-royal-btn:hover { color: #fbbf24; }
        .nav-royal-btn:hover::after { width: 80%; }
        .nav-royal-btn.active { color: #fbbf24; font-weight: 700; }
        .nav-royal-btn.active::after { width: 85%; }

        /* Smooth Accordion Details Styling */
        details[open] summary svg {
            transform: rotate(180deg);
        }
    </style>
</head>
