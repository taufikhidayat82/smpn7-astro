                            <div class="grid sm:grid-cols-3 gap-2 text-xs">
                                <div><strong class="text-slate-500">Bank:</strong> <p class="font-semibold text-slate-800">{dokumenPerizinan.bank}</p></div>
                                <div><strong class="text-slate-500">No. Rekening:</strong> <p class="font-mono font-bold text-indigo-700">{dokumenPerizinan.rekeningBOS}</p></div>
                                <div><strong class="text-slate-500">Atas Nama:</strong> <p class="font-semibold text-slate-800">{dokumenPerizinan.atasNama}</p></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. DATA PERIODIK & SANITASI / UKS -->
                <div class="grid md:grid-cols-2 gap-8">
                    
                    <!-- DATA PERIODIK -->
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between">
                        <div>
                            <div class="bg-[#0a1128] px-6 py-4 border-b border-amber-500/30 flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-amber-400/20 text-amber-400 flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                </div>
                                <h2 class="text-base font-extrabold text-amber-400">3. Data Periodik & Layanan</h2>
                            </div>
                            <div class="p-5 space-y-3 text-xs">
                                <div class="flex justify-between py-2 border-b border-slate-100">
                                    <span class="text-slate-500 font-medium">Waktu Penyelenggaraan</span>
                                    <span class="font-bold text-slate-900">{dataPeriodik.waktuPenyelenggaraan}</span>
                                </div>
                                <div class="flex justify-between py-2 border-b border-slate-100">
                                    <span class="text-slate-500 font-medium">Sumber & Daya Listrik</span>
                                    <span class="font-bold text-slate-900">{dataPeriodik.sumberListrik} ({dataPeriodik.dayaListrik})</span>
                                </div>
                                <div class="flex justify-between py-2 border-b border-slate-100">
                                    <span class="text-slate-500 font-medium">Akses Internet Utama</span>
                                    <span class="font-bold text-slate-900">{dataPeriodik.aksesInternet}</span>
                                </div>
