// src/pages/profil-sekolah.astro
import { getCollection } from 'astro:content';

// Data Profil Sekolah diambil secara akurat dari file profil-sekolah.xlsx
const identitasSekolah = {
  nama: 'SMP NEGERI 07 SATAP NANGA MAHAP',
  npsn: '30109762',
  jenjang: 'SMP',
  status: 'Negeri',
  alamat: 'Dusun Tembesuk, RT 01 / RW 01',
  kelurahan: 'Tembesuk',
  kecamatan: 'Kec. Nanga Mahap',
  kabupaten: 'Kab. Sekadau',
  provinsi: 'Prov. Kalimantan Barat',
  kodePos: '78585',
  negara: 'Indonesia',
  koordinat: 'Lintang: -0.4825 | Bujur: 110.7941',
};

const dokumenPerizinan = {
  skPendirian: '127 tahun 2010',
  tglSkPendirian: '06 Mei 2010',
  skIzinOperasional: '127 Tahun 2010',
  tglSkIzinOperasional: '06 Mei 2010',
  statusKepemilikan: 'Pemerintah Daerah',
  mbs: 'Ya (Manajemen Berbasis Sekolah)',
  npwp: '712110295705000',
  namaWajibPajak: 'SMP NEGERI 07 SATAP NANGA MAHAP',
  bank: 'BPD KALIMANTAN BARAT (Cabang Sekadau)',
  rekeningBOS: '9525030129',
  atasNama: 'BOSSMPN07NANGAMAHAP',
};

const dataPeriodik = {
  waktuPenyelenggaraan: 'Pagi / 6 Hari',
  sumberListrik: 'PLN',
  dayaListrik: '900 Watt',
  aksesInternet: 'Telkomsel',
  menerimaBOS: 'Ya',
  sertifikasiISO: '9001:2000',
  website: 'http://smpn07satapnangamahap.com',
};

const dataSanitasiUKS = [
  { label: 'Sumber Air bersih', value: 'Ledeng / PAM' },
  { label: 'Kecukupan Air Bersih', value: 'Cukup Sepanjang Waktu' },
  { label: 'Tipe Jamban', value: 'Leher Angsa (Toilet Duduk / Jongkok)' },
  { label: 'Saluran Pembuangan Limbah', value: 'Tangki Septik / IPAL' },
  { label: 'Tempat Sampah Per Kelas & Jamban', value: 'Tersedia Lengkap (Tertutup)' },
  { label: 'Tempat Pembuangan Sementara (TPS)', value: 'Tersedia & Diangkut Rutin' },
  { label: 'Selokan Genangan Air', value: 'Tersedia (Bebas Genangan)' },
  { label: 'Kemitraan Sanitasi', value: 'Pemerintah Daerah & Puskesmas' },
];

// Ambil berita dari Content Collection & urutkan dari yang paling baru
const rawAllBerita = (await getCollection('berita')) || [];
const beritaTerbaru = rawAllBerita
  .sort((a, b) => {
    const timeA = a.data?.pubDate ? new Date(a.data.pubDate).getTime() : 0;
    const timeB = b.data?.pubDate ? new Date(b.data.pubDate).getTime() : 0;

    const validA = Number.isNaN(timeA) ? 0 : timeA;
    const validB = Number.isNaN(timeB) ? 0 : timeB;

    return validB - validA; // Tanggal terbaru muncul lebih dahulu
  })
  .slice(0, 3);

const getCategoryBadge = (category: string) => {
  switch (category?.toUpperCase()) {
    case 'PRESTASI': return 'bg-blue-600 text-white';
    case 'FASILITAS': return 'bg-emerald-600 text-white';
    case 'PPDB': return 'bg-amber-500 text-slate-900';
    case 'KEGIATAN': return 'bg-purple-600 text-white';
    case 'EKSTRAKURIKULER': return 'bg-red-600 text-white';
    default: return 'bg-indigo-600 text-white';
  }
};
